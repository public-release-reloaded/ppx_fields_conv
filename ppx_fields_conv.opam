opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_fields_conv"
bug-reports: "https://github.com/public-release-reloaded/ppx_fields_conv/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_fields_conv.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_fields_conv/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base"
  "fieldslib"
  "ppx_helpers"
  "ppxlib_jane"
  "dune"        {>= "3.17.0"}
  "ppxlib"      {>= "0.38.0"}
]
available: arch != "x86_32"
synopsis: "Generation of accessor and iteration functions for ocaml records"
description: "
Part of the Jane Street's PPX rewriters collection.
"
